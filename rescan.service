# Re-scans the projects people chose to watch, and records their risk history in PostgreSQL.
[Unit]
Description=Mithra Security nightly re-scan
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root
Environment=HOME=/root
Environment=TZ=America/Los_Angeles
ExecStart=/root/.local/bin/uv run /root/app.py --rescan
